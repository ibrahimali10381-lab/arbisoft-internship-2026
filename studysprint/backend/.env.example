# Copy to .env. Everything is optional: without LLM keys the app uses its offline local models.
JWT_SECRET=change-me
# DATABASE_URL=sqlite:///./studysprint.db
# CORS_ORIGINS=http://localhost:5173

# Order in which models are tried for each AI task (unavailable ones are skipped,
# local-keyword is always the final fallback).
MODEL_PRIORITY=openai,groq,ollama,local-keyword

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
